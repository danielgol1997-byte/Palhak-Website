# Database URLs (Neon Postgres)
# Use pooled URL for DATABASE_URL (runtime)
# Use direct URL for DIRECT_URL (migrations)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"

# NextAuth Configuration
# Generate a random secret: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Optional: Restrict logins to specific domains (comma-separated)
# GOOGLE_ALLOWED_DOMAINS="example.com,another-domain.com"

# Seed Configuration (for initial super admin)
SEED_SUPER_ADMIN_EMAIL="admin@example.com"
SEED_SUPER_ADMIN_NAME="Admin User"

# Node Environment
NODE_ENV="development"

# ── Backups (see BACKUPS.md) ──
# Private Vercel Blob store token: off-site mirror of every backup. Optional but recommended.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# Protects /api/cron/backup. Vercel sends it automatically as "Authorization: Bearer <secret>".
# CRON_SECRET="generate with: openssl rand -base64 32"
# Destructive reset endpoints (/api/admin/reset-database, /api/admin/fresh-reset) are inert unless:
# ALLOW_DB_RESET="true"

# ── AI agent (super admins only) ──────────────────────────────────────────────
# API key from https://console.anthropic.com → API keys. Without it the agent
# button still appears but answers "not configured". See AGENT.md.
ANTHROPIC_API_KEY=""
# Optional. Default: claude-haiku-5-5 (cheapest). Alternative: claude-sonnet-5-5.
# AGENT_MODEL="claude-haiku-5-5"
# Optional per-operator limits (defaults: 12 per minute, 300 per day).
# AGENT_RATE_PER_MINUTE="12"
# AGENT_RATE_PER_DAY="300"
